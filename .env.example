PORT=3000
DISCORD_BOT_TOKEN=your_discord_bot_token
ROBLOX_OPEN_CLOUD_API_KEY=your_roblox_open_cloud_api_key
XTRACKER_API_KEY=your_xtracker_api_key
ROBLOX_WATCHER_API_KEY=your_roblox_watcher_api_key
EXPLOIT_WATCHER_API_KEY=your_exploit_watcher_api_key
# Optional CyberGuard Helper password delivery. Use the same value as the
# Worker's CYBERGUARD_INTEGRATION_TOKEN secret.
CYBERGUARD_BASE_URL=https://your-cyberguard-site.example
CYBERGUARD_INTEGRATION_TOKEN=the_same_token_as_the_worker_secret
# Optional local AI. The bot runs without Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
